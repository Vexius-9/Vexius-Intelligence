  "description": "Official Vexius Intelligence MCP (Model Context Protocol) Server — connect Claude, Cursor, and any MCP-compatible AI to your Vexius workspace.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
