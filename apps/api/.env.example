# Supabase JWT Secret for verifying auth tokens
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Prisma Database connection strings
DATABASE_URL=postgres://user:password@host:port/database
DIRECT_URL=postgres://user:password@host:port/database

# Supabase Storage & API Config
SUPABASE_URL="https://your_project_id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# ONLYOFFICE Config
ONLYOFFICE_JWT_SECRET="your_onlyoffice_secret_here"
API_BASE_URL="http://localhost:3000"

# AI Provider Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# X.AI (Grok) - T2
LLM_T2_BASE_URL=https://api.x.ai/v1
LLM_T2_API_KEY=your_xai_api_key_here
LLM_T2_MODEL=grok-4.3

# DeepSeek - T1
LLM_T1_BASE_URL=https://api.deepseek.com/v1
LLM_T1_API_KEY=your_deepseek_api_key_here
LLM_T1_MODEL=deepseek-chat
