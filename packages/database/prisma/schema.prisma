generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String?
  avatar     String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  workspaces Workspace[]
  members    WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id        String      @id @default(uuid())
  name      String
  ownerId   String      @map("owner_id")
  owner     User        @relation(fields: [ownerId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")
  aiTokensUsed Int         @default(0) @map("ai_tokens_used")
  members      WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        String    @default("editor") // owner, admin, editor, viewer
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

model Document {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  ownerId         String   @map("owner_id")
  name            String
  type            String   // document, spreadsheet, presentation, pdf, folder
  mimeType        String   @map("mime_type")
  storageKey      String   @map("storage_key")
  size            Int
  currentVersion  Int      @default(1) @map("current_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  
  parentId        String?   @map("parent_id")
  parent          Document? @relation("FolderChildren", fields: [parentId], references: [id])
  children        Document[] @relation("FolderChildren")

  versions        DocumentVersion[]
  permissions     DocumentPermission[]
  chunks          DocumentChunk[]

  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  version     Int
  storageKey  String   @map("storage_key")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  document    Document @relation(fields: [documentId], references: [id])

  @@map("document_versions")
}

model DocumentPermission {
  documentId  String   @map("document_id")
  userId      String   @map("user_id")
  permission  String   // view, comment, edit, owner

  document    Document @relation(fields: [documentId], references: [id])

  @@id([documentId, userId])
  @@map("document_permissions")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  content    String
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  action      String
  resource    String?
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model WorkspaceMemory {
  id               String   @id @default(uuid())
  workspaceId      String   @map("workspace_id")
  type             String   // preference, fact, entity, assumption, decision, template
  key              String
  value            String
  sourceDocumentId String?  @map("source_document_id")
  confidence       Float    @default(1.0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("workspace_memories")
}

model Automation {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  userId      String          @map("user_id")
  name        String
  prompt      String
  schedule    String          // Cron expression or interval definition
  status      String          @default("active") // active, paused
  lastRunAt   DateTime?       @map("last_run_at")
  nextRunAt   DateTime?       @map("next_run_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  runs        AutomationRun[]

  @@map("automations")
}

model AutomationRun {
  id           String     @id @default(uuid())
  automationId String     @map("automation_id")
  status       String     @default("pending") // pending, running, completed, failed
  result       String?
  startedAt    DateTime   @default(now()) @map("started_at")
  completedAt  DateTime?  @map("completed_at")
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("automation_runs")
}

model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  @@map("api_keys")
}

model MarketplaceAgent {
  id          String   @id @default(uuid())
  name        String
  description String
  version     String
  author      String
  manifestUrl String   @map("manifest_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("marketplace_agents")
}
